# ControlPlane.ai Environment Settings

# Enable offline mock model evaluations during local development/hackathon (true/false)
MOCK_ML=true

# Model configuration paths or overrides
PII_MODEL_ID=iiiorg/piiranha-v1-detect-personal-information
TOXICITY_MODEL_ID=unitary/toxic-bert
INJECTION_MODEL_ID=protectai/deberta-v3-base-prompt-injection-v2
BIAS_MODEL_ID=distilbert-base-uncased
VERIFIER_MODEL_ID=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
EMBEDDING_MODEL_ID=BAAI/bge-base-en-v1.5

# Device configuration (cpu, cuda, mps)
DEVICE=cpu

# Log configurations
AUDIT_LOG_PATH=data/audit_log.jsonl
FAISS_INDEX_DIR=data/indices

# Server settings
PORT=8000
HOST=0.0.0.0
